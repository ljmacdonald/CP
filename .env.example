# Copy to .env.local for local development. Never commit .env.local.

# ---------------------------------------------------------------------------
# Solana (public — safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_EXPLORER=https://explorer.solana.com

# ---------------------------------------------------------------------------
# Solana (server-only — used for backend transaction verification)
# Defaults to NEXT_PUBLIC_SOLANA_RPC_URL if unset. Set this separately in
# production to use a private/rate-limited RPC provider for the backend.
# ---------------------------------------------------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---------------------------------------------------------------------------
# Supabase (server-only secrets — NEVER expose the service role key to the client)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (public — anon key, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Platform wallets
# ---------------------------------------------------------------------------
# The devnet address deposits are verified against.
DEPOSIT_WALLET_ADDRESS=

# Comma-separated wallet addresses allowed into /admin.
ADMIN_WALLET_ADDRESSES=

# ---------------------------------------------------------------------------
# App secrets
# ---------------------------------------------------------------------------
# HMAC/JWT signing secret for session + challenge tokens. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Mock SOL -> NGN exchange rate, in minor units (kobo) per 1 SOL.
# In production this would be swapped for a real price oracle without
# changing any caller of getSolToNgnRateMinorUnits().
SOL_TO_NGN_RATE_MINOR_UNITS=150000000
