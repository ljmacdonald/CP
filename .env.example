# Copy to .env.local for local development. Never commit .env.local.

# ---------------------------------------------------------------------------
# Solana (public — safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_EXPLORER=https://explorer.solana.com

# ---------------------------------------------------------------------------
# Solana (server-only — used for backend transaction verification)
# Defaults to NEXT_PUBLIC_SOLANA_RPC_URL if unset. Set this separately in
# production to use a private/rate-limited RPC provider for the backend.
# ---------------------------------------------------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---------------------------------------------------------------------------
# Supabase (server-only secrets — NEVER expose the service role key to the client)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (public — anon key, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Platform wallets
# ---------------------------------------------------------------------------
# The devnet address deposits are verified against.
DEPOSIT_WALLET_ADDRESS=

# Comma-separated wallet addresses allowed into /admin.
ADMIN_WALLET_ADDRESSES=

# ---------------------------------------------------------------------------
# App secrets
# ---------------------------------------------------------------------------
# HMAC/JWT signing secret for session + challenge tokens. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Deposit asset
# ---------------------------------------------------------------------------
# The SPL token mint deposits are verified against (6 decimals). Defaults to
# Circle's official Solana devnet USDC mint if unset — see
# https://developers.circle.com/stablecoins/docs/usdc-on-test-networks
NEXT_PUBLIC_USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
